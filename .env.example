# Copy to .env in the repo root. Do not commit .env or .env.local.
# backend/config.py reads this file. Vite reads the VITE_ keys from the same file.

# Full Postgres URL. When this is set, the POSTGRES_* keys below are ignored.
DATABASE_URL=

# Used only when DATABASE_URL is empty. Leave POSTGRES_USER empty to skip
# Postgres and use the in-memory roster.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=koc10930
POSTGRES_USER=
POSTGRES_PASSWORD=

# Long random string. When empty, the API writes a gitignored local signing key.
JWT_SECRET=

# true when the site is served over HTTPS.
COOKIE_SECURE=false

# lax, strict, or none. none requires COOKIE_SECURE=true in the browser.
COOKIE_SAMESITE=lax

# Comma-separated browser origins. Empty keeps the local Vite origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Empty keeps the local Vite port pattern. Set off to disable the pattern.
CORS_ORIGIN_REGEX=

# Empty uses backend/uploads. An absolute path or a repo-relative path also works.
UPLOAD_DIR=

# Empty uses redis://localhost:6379/0. Set off to disable the cache.
REDIS_URL=redis://localhost:6379/0

# Ceiling for a dedicated Redis process. This is not reserved up front.
# Set off to skip CONFIG SET on a small machine.
REDIS_MAXMEMORY=48gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Browser-visible API origin. Empty keeps same-origin /api (the Vite proxy in dev).
VITE_API_BASE=

# Dev-server proxy target. Not sent to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# Outbound mail for the Cloudflare role. Unset or MAIL_ENABLED=false leaves sending off.
# CLOUDFLARE_EMAIL_TOKEN is the Email Sending token. Routing does not read it.
# MAIL_FROM must be an address on the routing domain, such as council@mistymountains.dev.
MAIL_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
MAIL_FROM=
MAIL_OFFICER_TO=

# Inbound Email Routing for officer and director addresses.
# CLOUDFLARE_API_TOKEN is the bearer token. It is not CLOUDFLARE_EMAIL_TOKEN.
# Include this account, and limit the zone to the routing domain.
# Email Routing Rules: Write covers /zones/{zone_id}/email/routing/rules.
# Email Routing Addresses: Write covers /accounts/{account_id}/email/routing/addresses.
# A zone-only token fails the address call. Account Rules write is not used.
# Leave the token empty in development. Do not commit a real token.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Empty uses the testing domain mistymountains.dev.
CLOUDFLARE_ROUTING_DOMAIN=mistymountains.dev
